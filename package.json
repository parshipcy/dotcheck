  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/parshipcy/dotcheck/issues"
  },
  "homepage": "https://github.com/parshipcy/dotcheck#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
