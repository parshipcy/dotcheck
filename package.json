{
  "name": "dotcheck",
  "version": "1.0.0",
  "description": "CLI that checks whether a project's environment variables are configured correctly",
  "bin": {
    "dotcheck": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/cli.ts",
    "check-env": "node dist/cli.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/parshipcy/dotcheck.git"
  },
  "keywords": [],
